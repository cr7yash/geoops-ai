# FastAPI
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000
SEED_DATA_PATH=data/seed/geoops_seed.json
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=10
KNOWLEDGE_DOCUMENTS_PATH=data/documents
EMBEDDING_DIMENSIONS=256
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
MODEL_PROVIDER=local
MODEL_NAME=geoops-local-planner-v1
# For MODEL_PROVIDER=gemini_api, set MODEL_NAME to a supported Gemini model.
GEMINI_API_KEY=
# For MODEL_PROVIDER=vertex_ai, use Application Default Credentials and set:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
APPROVAL_STORE=memory
APPROVAL_TTL_MINUTES=30
FIRESTORE_APPROVALS_COLLECTION=approval_requests

# Next.js (browser-visible; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
