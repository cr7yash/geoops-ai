# FastAPI
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000
SEED_DATA_PATH=data/seed/geoops_seed.json
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=10
KNOWLEDGE_DOCUMENTS_PATH=data/documents
EMBEDDING_DIMENSIONS=256
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120

# Next.js (browser-visible; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
