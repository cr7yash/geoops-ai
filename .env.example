# FastAPI
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000
SEED_DATA_PATH=data/seed/geoops_seed.json
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=10
KNOWLEDGE_DOCUMENTS_PATH=data/documents
EMBEDDING_DIMENSIONS=256
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
MODEL_PROVIDER=local
MODEL_NAME=geoops-local-planner-v1
# For MODEL_PROVIDER=gemini_api, set MODEL_NAME to a supported Gemini model.
GEMINI_API_KEY=
# For MODEL_PROVIDER=vertex_ai, use Application Default Credentials and set:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
APPROVAL_STORE=sqlite
STATE_DATABASE_PATH=data/runtime/state.sqlite3
EVENT_BUS=memory
PUBSUB_TOPIC=dispatch-approved
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
APPROVAL_TTL_MINUTES=30
FIRESTORE_APPROVALS_COLLECTION=approval_requests
CATALOG_PROVIDER=json
ANALYTICS_PROVIDER=local
BIGQUERY_DATASET=geoops
DOCUMENT_PROVIDER=local
DOCUMENTS_BUCKET=
VECTOR_PROVIDER=memory
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
AGENT_TIMEOUT_SECONDS=60
EVALUATION_DATASET_PATH=data/evaluation/cases.json
EVALUATION_THRESHOLDS_PATH=data/evaluation/thresholds.json
# Set API_TOKEN in staging/production. Supply the same value to the web server as GEOOPS_API_TOKEN.
API_TOKEN=
# Optional user-supplied model prices; leave unset when unknown.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=

# Next.js (browser-visible; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For the deployed server proxy, build with NEXT_PUBLIC_API_BASE_URL empty.
API_INTERNAL_BASE_URL=http://localhost:8000
API_USE_GOOGLE_ID_TOKEN=false
GEOOPS_API_TOKEN=
