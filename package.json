{
  "name": "geoops-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"pnpm api\" \"pnpm web\"",
    "web": "pnpm --filter @geoops/web dev",
    "api": "uv run --package geoops-api uvicorn geoops_api.main:app --app-dir apps/api/src --host 0.0.0.0 --port 8000 --reload",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "pnpm --filter @geoops/web test",
    "test:api": "uv run --package geoops-api pytest",
    "lint": "pnpm lint:web && pnpm lint:api",
    "lint:web": "pnpm --filter @geoops/web lint",
    "lint:api": "uv run --package geoops-api ruff check apps/api",
    "format": "pnpm format:web && pnpm format:api",
    "format:web": "pnpm --filter @geoops/web format",
    "format:api": "uv run --package geoops-api ruff format apps/api",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "pnpm --filter @geoops/web typecheck",
    "typecheck:api": "uv run --package geoops-api mypy apps/api/src",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm --filter @geoops/web build",
    "build:api": "uv build --package geoops-api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}

